{
	"name": "schemist",
	"description": "Cohesive and accessible color schemes.",
	"author": "Félix Girault <felix.girault@gmail.com>",
	"license": "MIT",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check",
		"format": "oxfmt",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/apca-w3": "^0.1.3",
		"@types/culori": "^4.0.1",
		"apca-w3": "^0.1.9",
		"color-name-list": "^14.80.0",
		"culori": "^4.0.2",
		"nearest-color": "^0.4.4",
		"oxfmt": "^0.74.0",
		"svelte": "^5.57.2",
		"svelte-accessible-dialog": "^2.1.3",
		"svelte-check": "^4.7.7",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
